MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/primecrest?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

NEXT_PUBLIC_SITE_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=primecrest

ADMIN_SEED_EMAIL=admin@primecrest.com
ADMIN_SEED_PASSWORD=change-me

# Live headlines for The Wire (homepage) and /news.
# NEWS_API_PROVIDER is "gnews" (gnews.io, default) or "newsapi" (newsapi.org).
# Note: NewsAPI.org's free Developer plan only works on localhost; production
# needs a paid plan. GNews's free plan allows production use (100 requests/day).
NEWS_API_PROVIDER=gnews
NEWS_API_KEY=
NEWS_API_COUNTRY=us
# Seconds to cache each topic's headlines (minimum 300).
NEWS_REVALIDATE=1800
