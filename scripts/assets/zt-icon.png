      try {
        var t = localStorage.getItem('zaptick:theme') || 'light';
        var a = localStorage.getItem('zaptick:accent') || 'emerald';
        var rm = localStorage.getItem('zaptick:reduce-motion') === '1';
        var resolved = t === 'system'
          ? (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        var html = document.documentElement;
        html.dataset.theme = resolved;
        html.dataset.themePreference = t;
        html.dataset.accent = a;
        if (rm) html.dataset.reduceMotion = 'true';
        html.style.colorScheme = resolved;
